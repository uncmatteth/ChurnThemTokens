{
  "manifest_version": 3,
  "name": "ChurnThemTokens",
  "version": "0.1.2",
  "description": "Connect an explicitly selected ChatGPT Pro web chat to your local computer tools. No Codex or model API calls.",
  "icons": {
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon128.png",
    "default_title": "ChurnThemTokens"
  },
  "key": ""
}
